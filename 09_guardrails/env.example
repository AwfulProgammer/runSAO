OPENAI_API_KEY="..."

# Splunk AO
SPLUNK_AO_REALM="us1"
SPLUNK_AO_O11Y_TOKEN="..."
SPLUNK_AO_PROJECT="..."
SPLUNK_AO_AGENT_STREAM="guardrails"

# Agent Control (SaaS)
AGENT_CONTROL_URL="https://<realm-host>/ao/agent-control"
AGENT_CONTROL_API_KEY_HEADER="X-SF-Token"
AGENT_CONTROL_AGENT_NAME="my-agent"
AGENT_CONTROL_TARGET_TYPE="log_stream"
AGENT_CONTROL_RUNTIME_AUTH_MODE="jwt"
AGENT_CONTROL_RUNTIME_TOKEN_HEADER="X-Agent-Control-Runtime-Token"

# On-prem / standalone only (header "Splunk-AO-API-Key"):
# SPLUNK_AO_API_KEY="..."
# SPLUNK_AO_CONSOLE_URL="..."
# AGENT_CONTROL_URL="https://api.<domain>/agent-control"
